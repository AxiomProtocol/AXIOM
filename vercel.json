{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "functions": {
    "pages/api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/erc3643/identity/expiry-check",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/refresh-solvency",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reserve-alerts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/reserve-snapshot",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/reconcile-polygon-reserve",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
