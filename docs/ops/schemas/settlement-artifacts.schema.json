{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiomprotocol.io/schemas/settlement-artifacts.schema.json",
  "title": "SettlementArtifacts",
  "description": "Schema for settlement artifact requirements and validation",
  "type": "object",
  "required": ["packetId", "trackType", "artifactIndex", "validationStatus"],
  "properties": {
    "packetId": {
      "type": "string",
      "pattern": "^PKT-[AB]-[0-9]{4}-[0-9]{3}$",
      "description": "Reference to parent packet"
    },
    "trackType": {
      "type": "string",
      "enum": ["PERFORMING", "LIGHT_NPL"],
      "description": "Asset track classification"
    },
    "artifactIndex": {
      "type": "object",
      "description": "Map of artifact references",
      "additionalProperties": {
        "$ref": "#/$defs/ArtifactReference"
      }
    },
    "requiredArtifacts": {
      "type": "object",
      "description": "Required artifacts per track type",
      "properties": {
        "PERFORMING": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "paymentHistoryProof",
            "servicerStatement",
            "lienPositionVerification",
            "participationAgreement",
            "cashflowSchedule"
          ]
        },
        "LIGHT_NPL": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "delinquencyStatusSummary",
            "borrowerContactLog",
            "workoutOptionsMatrix",
            "timelineAssumptions",
            "downsideDisclosure",
            "servicingEventLogTemplate",
            "participationAgreement"
          ]
        }
      }
    },
    "validationStatus": {
      "type": "object",
      "required": ["isComplete", "missingArtifacts", "invalidArtifacts", "validatedAt"],
      "properties": {
        "isComplete": {
          "type": "boolean",
          "description": "All required artifacts present and valid"
        },
        "missingArtifacts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of missing required artifacts"
        },
        "invalidArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactValidationError"
          },
          "description": "List of artifacts with validation errors"
        },
        "validatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last validation timestamp"
        },
        "validatedBy": {
          "type": "string",
          "description": "Validator identifier (script or operator)"
        }
      }
    },
    "cidEnforcement": {
      "type": "object",
      "description": "DeNet CID enforcement status",
      "properties": {
        "enforced": {
          "type": "boolean",
          "description": "Whether CID enforcement is active"
        },
        "verifiedCids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^bafy[a-z0-9]+$"
          },
          "description": "List of verified CIDs"
        },
        "pendingVerification": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Artifacts pending CID verification"
        }
      }
    }
  },
  "$defs": {
    "ArtifactReference": {
      "type": "object",
      "required": ["filename", "uploadedAt"],
      "properties": {
        "cid": {
          "type": "string",
          "pattern": "^bafy[a-z0-9]+$",
          "description": "IPFS/DeNet Content Identifier"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA256 hash of file content"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "description": "Original filename"
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Upload timestamp"
        },
        "uploadedBy": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "description": "Uploader address"
        },
        "fileSize": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes"
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type of file"
        },
        "verified": {
          "type": "boolean",
          "description": "Whether artifact has been verified"
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Verification timestamp"
        }
      }
    },
    "ArtifactValidationError": {
      "type": "object",
      "required": ["artifactKey", "errorCode", "errorMessage"],
      "properties": {
        "artifactKey": {
          "type": "string",
          "description": "Artifact identifier"
        },
        "errorCode": {
          "type": "string",
          "enum": [
            "MISSING_CID",
            "MISSING_HASH",
            "INVALID_CID_FORMAT",
            "INVALID_HASH_FORMAT",
            "CID_VERIFICATION_FAILED",
            "FILE_NOT_FOUND",
            "FILE_CORRUPTED",
            "EXPIRED",
            "WRONG_FORMAT"
          ],
          "description": "Validation error code"
        },
        "errorMessage": {
          "type": "string",
          "description": "Human-readable error description"
        }
      }
    }
  },
  "examples": [
    {
      "packetId": "PKT-A-2026-001",
      "trackType": "PERFORMING",
      "artifactIndex": {
        "paymentHistoryProof": {
          "cid": "bafybeig5a7h...",
          "sha256": "a1b2c3d4e5f6...",
          "filename": "payment-history-18mo.pdf",
          "uploadedAt": "2026-01-30T10:00:00Z",
          "verified": true
        },
        "servicerStatement": {
          "cid": "bafybeih6b8i...",
          "sha256": "f6g7h8i9j0k1...",
          "filename": "servicer-statement-jan2026.pdf",
          "uploadedAt": "2026-01-30T10:05:00Z",
          "verified": true
        }
      },
      "validationStatus": {
        "isComplete": false,
        "missingArtifacts": ["lienPositionVerification", "cashflowSchedule"],
        "invalidArtifacts": [],
        "validatedAt": "2026-01-31T14:30:00Z",
        "validatedBy": "prevalidate-settlement-artifacts.ts"
      }
    }
  ]
}
