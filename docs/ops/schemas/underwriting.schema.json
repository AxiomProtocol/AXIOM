{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://axiomprotocol.io/schemas/underwriting.schema.json",
  "title": "UnderwritingOutput",
  "description": "Schema for property packet underwriting analysis output",
  "type": "object",
  "required": [
    "packetId",
    "trackType",
    "purchasePrice",
    "participationAmount",
    "impliedYieldRange",
    "riskTier",
    "riskReasonCodes",
    "underwritingHash",
    "finalizedAt"
  ],
  "properties": {
    "packetId": {
      "type": "string",
      "pattern": "^PKT-[AB]-[0-9]{4}-[0-9]{3}$",
      "description": "Reference to parent packet"
    },
    "trackType": {
      "type": "string",
      "enum": ["PERFORMING", "LIGHT_NPL"],
      "description": "Asset track classification"
    },
    "purchasePrice": {
      "type": "number",
      "minimum": 0,
      "description": "Offered acquisition price in USD"
    },
    "participationAmount": {
      "type": "number",
      "minimum": 0,
      "description": "Capital participation amount in USD"
    },
    "impliedYieldRange": {
      "type": "string",
      "pattern": "^[0-9.]+% - [0-9.]+%$",
      "description": "Conservative yield estimate range"
    },
    "collateralValueEstimate": {
      "type": "number",
      "minimum": 0,
      "description": "Property value estimate in USD"
    },
    "collateralConfidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "description": "Confidence level in collateral valuation"
    },
    "ltvProxy": {
      "type": "number",
      "minimum": 0,
      "maximum": 200,
      "description": "Loan-to-value ratio as percentage"
    },
    "dscrProxy": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Debt service coverage ratio (if rental income known)"
    },
    "recoveryEstimate": {
      "type": "string",
      "description": "Expected recovery range for NPL (Track B only)"
    },
    "workoutProbability": {
      "type": "string",
      "description": "Primary workout success probability (Track B only)"
    },
    "timelineMonths": {
      "type": "string",
      "description": "Expected resolution timeline (Track B only)"
    },
    "riskTier": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"],
      "description": "Overall risk classification"
    },
    "riskReasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "LTV_ELEVATED",
          "LTV_UNDERWATER",
          "SHORT_PAYMENT_HISTORY",
          "DELINQUENT",
          "WORKOUT_REQUIRED",
          "BORROWER_UNRESPONSIVE",
          "PROPERTY_VACANT",
          "JUDICIAL_STATE",
          "SECOND_LIEN",
          "SERVICER_UNVERIFIED",
          "VALUATION_UNCERTAIN",
          "ESCROW_SHORTAGE",
          "LEGAL_PENDING"
        ]
      },
      "description": "Array of risk factor codes"
    },
    "underwritingHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA256 hash of underwriting data for integrity verification"
    },
    "inputs": {
      "type": "object",
      "description": "Raw input values used in underwriting calculation",
      "properties": {
        "upb": {
          "type": "number"
        },
        "interestRate": {
          "type": "number"
        },
        "monthlyPayment": {
          "type": "number"
        },
        "propertyValue": {
          "type": "number"
        },
        "monthlyRent": {
          "type": ["number", "null"]
        },
        "missedPayments": {
          "type": ["integer", "null"]
        },
        "totalPastDue": {
          "type": ["number", "null"]
        }
      }
    },
    "assumptions": {
      "type": "object",
      "description": "Conservative assumptions applied",
      "properties": {
        "vacancyRate": {
          "type": "number",
          "description": "Assumed vacancy rate percentage"
        },
        "managementFee": {
          "type": "number",
          "description": "Assumed management fee percentage"
        },
        "maintenanceReserve": {
          "type": "number",
          "description": "Assumed annual maintenance reserve"
        },
        "workoutCosts": {
          "type": "number",
          "description": "Assumed workout costs (Track B)"
        },
        "legalCosts": {
          "type": "number",
          "description": "Assumed legal costs (Track B)"
        },
        "timelineBuffer": {
          "type": "number",
          "description": "Additional months buffer for timeline"
        }
      }
    },
    "finalizedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when underwriting was finalized"
    },
    "finalizedBy": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "description": "Address of underwriter"
    },
    "reviewNotes": {
      "type": "string",
      "description": "Optional underwriter notes"
    }
  }
}
