modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["resend:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AXIOM Dev Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build Test"

[[workflows.workflow]]
name = "AXIOM Dev Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Dev server paused for build test\""

[[workflows.workflow]]
name = "Build Test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && NODE_ENV=production NODE_OPTIONS='--max-old-space-size=8192' npx next build 2>&1 && echo \"===BUILD_SUCCESS===\" && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && echo \"===ASSETS_COPIED===\" || echo \"===BUILD_FAILED===\""

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["jq"]

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "start:minimal"]
build = ["npm", "run", "build:deploy:clean"]

[userenv]

[userenv.production]
ADMIN_WALLETS = "0xa6ed10e752d5facd989ee9ced113b3a064b47493"
PUBLIC_DOMAIN = "axiomprotocol.app"

[userenv.shared]
MIRDT_SCAN_KEY = "mirdt-dev-scan-2026"
