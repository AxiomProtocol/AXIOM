modules = ["nodejs-20", "postgresql-16"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AXIOM Dev Server"

[[workflows.workflow]]
name = "AXIOM Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["jq"]

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "export HOST=0.0.0.0 && export HOSTNAME=0.0.0.0 && export PORT=5000 && node .next/standalone/server.js"]
build = ["npm", "run", "build:deploy:clean"]
