modules = ["nodejs-20", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["resend:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AXIOM Dev Server"

[[workflows.workflow]]
name = "AXIOM Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["jq"]

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "export HOST=0.0.0.0 && export HOSTNAME=0.0.0.0 && export PORT=5000 && node .next/standalone/server.js"]
build = ["bash", "-c", "rm -rf node_modules package-lock.json .next 2>/dev/null || true; npm cache clean --force 2>/dev/null || true; npm install --legacy-peer-deps && npm run build:deploy:clean"]

[userenv]

[userenv.production]
ADMIN_WALLETS = "0xa6ed10e752d5facd989ee9ced113b3a064b47493"
PUBLIC_DOMAIN = "axiomprotocol.app"
