# ============================================
# AXIOM ENVIRONMENT CONFIGURATION
# ============================================

# Environment: local | staging | production
# Defaults to 'local' if not set, or 'production' if NODE_ENV=production
AXIOM_ENV=local

# AI Agent Mode: off | observe | propose
# - off: AI agent features disabled (default in production)
# - observe: AI can analyze but not suggest changes
# - propose: AI can suggest changes (staging only by default)
AI_AGENT_MODE=off

# Override to enable AI in production (requires explicit opt-in)
# AI_AGENT_PRODUCTION_OVERRIDE=false

# Audit Log Sink: database | console | file
AUDIT_LOG_SINK=database

# Base URLs for different environments
STAGING_BASE_URL=https://staging.axiomprotocol.com
PROD_BASE_URL=https://axiomprotocol.com

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================

TELEGRAM_BOT_TOKEN=your_sovran_access_bot_token_here
TELEGRAM_GROUP_USERNAME=your_telegram_group_username_here

# MongoDB Configuration (if using a remote database)
MONGODB_URI=your_mongodb_connection_string_here

# Admin Configuration
ADMIN_USERNAMES=username1,username2

# Optional: URL Shortener Configuration (for branded links)
URL_SHORTENER_DOMAIN=swf.link

# ============================================
# SUPABASE CONFIGURATION (Admin RBAC)
# ============================================

# Supabase project URL (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# IMPORTANT: Server-only - NEVER expose to client
# This key has full admin access to your Supabase project
# Used for admin user management operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# AXIOM PROTOCOL DEPLOYMENT CONFIGURATION
# ============================================

# Deployment Configuration
DEPLOYER_PK=0xyourprivatekeyhere
ADMIN=0xYourAdminAddressHere

# Network Configuration
PEAQ_RPC_URL=https://evm.peaq.network
PEAQ_API_KEY=not-required

# Gold Reserve Configuration
SCHEMA_CUSTODIAN=0x435553544f4449414e5f5631
SCHEMA_AUDITOR=0x41554449544f525f5631
GOLD_CUSTODIAN=0xOptionalCustodianAddress
GOLD_AUDITOR=0xOptionalAuditorAddress

# Rewards Vault Configuration
MONTHLY_CAP_AXM=100000
LOCK_SECONDS=2592000
# Real Estate Deal Intelligence
# Postgres with PostGIS enabled (required for RE module)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ATTOM Data Solutions API (https://api.developer.attomdata.com)
# Provides property profile, sales history, and tax assessment data
# Sign up at developer.attomdata.com for a free trial key
ATTOM_API_KEY=

# Rentcast API (https://app.rentcast.io/app/api)
# Provides rent estimates, value estimates, and rental comps
# Sign up at rentcast.io for an API key
RENTCAST_API_KEY=

# GitHub API token for fetching repository pull requests (optional, increases rate limit)
GITHUB_TOKEN=

# ============================================
# INCREASE BANKING (Axiom Nexus Account)
# https://increase.com — FDIC-insured banking rails via First Internet Bank
# ============================================

# Banking environment: 'production' for live money, 'sandbox' for testing.
# Controls which account/entity/program IDs are used and which API base URL is called.
# IMPORTANT: This must also be set in the Vercel dashboard for deployed environments.
INCREASE_ENVIRONMENT=sandbox

# Increase API key — server-only, NEVER expose to client.
# Obtain from: Increase dashboard → Settings → API Keys
INCREASE_API_KEY=

# Optional: override the production API base URL. Leave blank to use the default.
# Default when unset: https://api.increase.com
INCREASE_BASE_URL=

# --- Production account IDs (used when INCREASE_ENVIRONMENT=production) ---

# Axiom Nexus Account ID (format: account_*)
# The main treasury operating account at First Internet Bank.
INCREASE_ACCOUNT_ID=

# Axiom Protocol LLC entity ID (format: entity_*)
# The registered legal entity for org-level operations.
INCREASE_ENTITY_ID=

# Program ID for per-participant account provisioning (format: program_*)
# Required for onboarding — onboard.ts hard-fails if this is missing.
INCREASE_PROGRAM_ID=

# --- Sandbox account IDs (used when INCREASE_ENVIRONMENT=sandbox) ---

# Sandbox Axiom Nexus Account ID (format: sandbox_account_*)
INCREASE_SANDBOX_ACCOUNT_ID=

# Sandbox entity ID (format: sandbox_entity_*)
INCREASE_SANDBOX_ENTITY_ID=

# Sandbox program ID (format: sandbox_program_*)
# Required for sandbox onboarding flows.
INCREASE_SANDBOX_PROGRAM_ID=

# Webhook signing secret — used to validate Increase webhook payloads (HMAC-SHA256).
# Obtain from: Increase dashboard → Settings → Webhooks → Signing Secret
# Required once GAP-001 (webhook handler) is implemented.
INCREASE_WEBHOOK_SECRET=
