# ============================================
# AXIOM ENVIRONMENT CONFIGURATION
# ============================================

# Environment: local | staging | production
# Defaults to 'local' if not set, or 'production' if NODE_ENV=production
AXIOM_ENV=local

# AI Agent Mode: off | observe | propose
# - off: AI agent features disabled (default in production)
# - observe: AI can analyze but not suggest changes
# - propose: AI can suggest changes (staging only by default)
AI_AGENT_MODE=off

# Override to enable AI in production (requires explicit opt-in)
# AI_AGENT_PRODUCTION_OVERRIDE=false

# Audit Log Sink: database | console | file
AUDIT_LOG_SINK=database

# Base URLs for different environments
STAGING_BASE_URL=https://staging.axiomprotocol.com
PROD_BASE_URL=https://axiomprotocol.com

# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================

TELEGRAM_BOT_TOKEN=your_sovran_access_bot_token_here
TELEGRAM_GROUP_USERNAME=your_telegram_group_username_here

# MongoDB Configuration (if using a remote database)
MONGODB_URI=your_mongodb_connection_string_here

# Admin Configuration
ADMIN_USERNAMES=username1,username2

# Optional: URL Shortener Configuration (for branded links)
URL_SHORTENER_DOMAIN=swf.link

# ============================================
# SUPABASE CONFIGURATION (Admin RBAC)
# ============================================

# Supabase project URL (safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# IMPORTANT: Server-only - NEVER expose to client
# This key has full admin access to your Supabase project
# Used for admin user management operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================
# AXIOM PROTOCOL DEPLOYMENT CONFIGURATION
# ============================================

# Deployment Configuration
DEPLOYER_PK=0xyourprivatekeyhere
ADMIN=0xYourAdminAddressHere

# Network Configuration
PEAQ_RPC_URL=https://evm.peaq.network
PEAQ_API_KEY=not-required

# Gold Reserve Configuration
SCHEMA_CUSTODIAN=0x435553544f4449414e5f5631
SCHEMA_AUDITOR=0x41554449544f525f5631
GOLD_CUSTODIAN=0xOptionalCustodianAddress
GOLD_AUDITOR=0xOptionalAuditorAddress

# Rewards Vault Configuration
MONTHLY_CAP_AXM=100000
LOCK_SECONDS=2592000