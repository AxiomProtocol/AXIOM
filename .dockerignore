# ============================================
# AGGRESSIVE .dockerignore for deployment size reduction
# ============================================

# ALL node_modules - standalone has its own minimal deps
node_modules
.pnpm-store
package-lock.json

# Next.js build artifacts EXCEPT standalone
.next/cache
.next/server
.next/static
.next/types
.next/trace
.next/BUILD_ID
.next/build-manifest.json
.next/prerender-manifest.json
.next/react-loadable-manifest.json
.next/required-server-files.json
.next/routes-manifest.json

# Source files (standalone has compiled versions)
pages/
components/
lib/
utils/
server/
client/
middleware/
shared/
routes/
styles/
apps/

# Development and test files
test/
tests/
__tests__/
coverage/
.nyc_output/
*.test.ts
*.test.js
*.spec.ts
*.spec.js

# Documentation
docs/
AXIOM.wiki/
wiki/
prompts/
*.md
!README.md

# Build/development tools (keep next.config.js, package.json, tsconfig.json for build)
drizzle/
migrations/
scripts/
integration/
contracts/
stablecoin-deploy/
hardhat.config.ts
drizzle.config.ts

# Data and logs
crawled_data/
tribevest_analysis/
logs/
data/
cache/
artifacts/

# Temporary directories
temp-compile-*/
denet-storage/
download/
recruit-standalone/
universe-blockchain/
project/
content/

# Large assets
attached_assets/
public/images/
*.zip
*.tar.gz
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.mp4
*.webm

# Python files
*.py
pyproject.toml
uv.lock
__pycache__/

# Shell scripts
*.sh

# Security and deployment
security/
web3/

# Replit specific
replit_agent/
.replit
replit.nix
replit.md

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment files
.env.local
.env.development
.env.test

# Version control
.git/
.gitignore

# Hardhat/Solidity
*.sol
*.sarif

# Miscellaneous large files
*.json.backup
*.txt
*.html
wallets.json
delegations.json
stakingLogs.json
simple-admin-data.json
