# ============================================
# .dockerignore - Exclude non-essential files only
# Keep all source code needed for Next.js build
# ============================================

# Development cache and temp files
.next/cache
node_modules/.cache
.pnpm-store

# Version control
.git
.gitignore

# IDE and editor files
.idea
.vscode
*.swp
*.swo

# Test files
test/
tests/
__tests__/
coverage/
.nyc_output/

# Documentation (not needed for runtime)
docs/
AXIOM.wiki/
wiki/
prompts/

# Data and logs (runtime generates its own)
crawled_data/
tribevest_analysis/
logs/
*.log

# Temporary and backup directories
temp-compile-*/
denet-storage/
download/
recruit-standalone/

# Python files (not needed for Node.js app)
*.py
pyproject.toml
uv.lock
__pycache__/

# Hardhat/Solidity development
cache/
artifacts/
stablecoin-deploy/
universe-blockchain/

# Large binary files
*.zip
*.tar.gz
*.sarif

# Replit specific (not needed in deployment)
replit_agent/
.replit
replit.nix

# Development environment files
.env.local
.env.development
.env.test

# Backup files
*.backup
*.json.backup

# Large static asset directories (serve from object storage instead)
public/keygrow-proof/
public/generated/
attached_assets/
