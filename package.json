  "scripts": {
    "dev": "next dev -p 5000",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=4096' next build && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && cp -r .next/server .next/standalone/.next/server",
    "build:replit": "NODE_ENV=production NODE_OPTIONS='--max-old-space-size=4096' next build && mkdir -p .next/standalone/.next && cp -r .next/static .next/standalone/.next/static && cp -r public .next/standalone/public && cp -r .next/server .next/standalone/.next/server",
    "start:minimal": "NODE_ENV=production HOSTNAME=0.0.0.0 PORT=5000 node server-production.js",
    "start": "NODE_ENV=production HOSTNAME=0.0.0.0 PORT=5000 node server-production.js",
    "snapshot": "node scripts/saveReserveSnapshot.js",
    "admin:reset-password": "node scripts/reset-admin-password.js",
    "test": "hardhat test",
    "test:node-economy": "npx tsx tests/node-economy-abi.test.ts",
    "test:credits-ledger": "npx tsx tests/credits-ledger.test.ts",
    "test:readiness-gate": "npx tsx tests/readiness-gate.test.ts",
    "test:note-portal": "npx tsx tests/note-portal.test.ts",
    "test:smoke": "npx tsx scripts/smoke-test.ts",
    "test:all": "npm run test:node-economy && npm run test:credits-ledger && npm run test:readiness-gate && npm run test:note-portal",
    "test:invariants": "hardhat test test/invariants/*.test.ts --config hardhat.config.ts",
    "test:scenarios": "hardhat test test/scenarios/*.test.ts --config hardhat.config.ts",
    "slither": "slither contracts/ --exclude-dependencies --json reports/slither-output.json 2>/dev/null || true",
    "audit:full": "npm run test:invariants && npm run test:scenarios",
    "audit:report": "node scripts/generate-audit-report.js",
